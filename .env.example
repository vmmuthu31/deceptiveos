# CipherNest Environment Configuration Template

# Database Pooler URL (PostgreSQL / Neon / Supabase / CockroachDB pooler connection string)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ciphernest?pgbouncer=true"

# Authentication JWT Secret Key
JWT_SECRET="ciphernest-super-secret-key-2026-production-grade"

# OpenCode AI API Configuration (https://opencode.ai/zen/v1/chat/completions)
OPENCODE_API_KEY="opencode_your_api_key_here"
OPENCODE_MODEL="mimo-v2.5-free"
# Supported OpenCode Free Models:
# - mimo-v2.5-free (MiMo-V2.5 Free - Xiaomi)
# - hy3-free (Hy3 Free - Stealth)
# - laguna-s-2.1-free (Laguna S 2.1 Free - Stealth)
# - nemotron-3-ultra-free (Nemotron 3 Ultra Free - NVIDIA)
# - nemotron-3.5-lightning-free (Nemotron 3.5 Lightning Free - NVIDIA)
# - deepseek-v4-flash-free (DeepSeek V4 Flash Free - DeepSeek)

# Nodemailer SMTP Email Alerts Configuration
# Note: Security alerts are automatically dispatched dynamically to all registered users with Admin rights.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="alerts@ciphernest.ai"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM="CipherNest Security <alerts@ciphernest.ai>"
