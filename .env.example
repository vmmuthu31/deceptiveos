# CipherNest Environment Configuration Template

# Database Pooler URL (PostgreSQL / Neon / Supabase / CockroachDB pooler connection string)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ciphernest?pgbouncer=true"

# Authentication JWT Secret Key
JWT_SECRET="ciphernest-super-secret-key-2026-production-grade"

# OpenCode AI API Configuration
OPENCODE_API_KEY=""
OPENCODE_MODEL="mimo-v2.5-free"
# Supported OpenCode Free Models:
# - mimo-v2.5-free
# - hy3-free
# - laguna-s-2.1-free
# - nemotron-3-ultra-free
# - nemotron-3.5-lightning-free
# - deepseek-v4-flash-free

# Local Ollama AI Engine Fallback Endpoint (if OpenCode API Key is not set)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# Nodemailer SMTP Email Alerts Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="alerts@ciphernest.ai"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM="CipherNest Security <alerts@ciphernest.ai>"
ALERT_EMAIL_RECIPIENT="secops@company.com"
