# STRK20 Privacy Pool Configuration
# Copy to .env.local and fill in values

# NOTE: Transactions run on Starknet TESTNET for now.
# Switch to mainnet after all tests pass and demo video is recorded.
# Code is written for mainnet — just swap these URLs and CHAIN_ID.

# Starknet RPC endpoint (required)
# Testnet: https://starknet-sepolia.public.blastapi.io
# Mainnet: https://starknet-mainnet.public.blastapi.io
RPC_URL=

# Account credentials (required for real transactions)
# Generate with starknet CLI or import from wallet
# Fund with testnet STRK from faucet before testing
ACCOUNT_ADDRESS=
ACCOUNT_PRIVATE_KEY=

# Viewing key for note discovery (required)
# Must be a numeric string (BigInt value, e.g., 12345678901234567890)
VIEWING_KEY=

# Proving service URL (required for real proofs)
# Testnet: https://prover.privacy-starknet-integration.starknet.io
# Mainnet: (same URL, different chain)
# Or run locally: docker run -p 3000:3000 ghcr.io/starkware-libs/starknet-privacy/transaction-prover:PRIVACY-0.14.3-RC.2
PROVING_SERVICE_URL=

# Discovery/indexer service URL (required for note discovery)
# Testnet: https://indexer.privacy-starknet-integration.starknet.io
# Mainnet: (same URL, different chain)
# Or run locally: docker run -p 8080:8080 ghcr.io/starkware-libs/starknet-privacy/discovery-service:PRIVACY-0.14.3-RC.2
INDEXER_URL=

# Privacy pool contract address (required)
# Testnet pool: (get from hackathon Telegram or deploy own)
# Mainnet pool: (same contract, different deployment)
POOL_ADDRESS=

# Chain ID (required)
# Testnet: 0x534e5f494e544547524154494f4e5f5345504f4c4941
# Mainnet: 0x534e5f4d41494e
CHAIN_ID=0x534e5f494e544547524154494f4e5f5345504f4c4941
