{
  "name": "ciphernest-electron",
  "version": "0.1.0",
  "description": "Electron main process for CipherNest",
  "main": "src/main.ts",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "electron . --no-sandbox",
    "build": "tsc && electron-builder --dir",
    "package": "electron-builder",
    "lint": "eslint src/**/*.ts"
  },
  "build": {
    "appId": "io.ciphernest.desktop",
    "productName": "CipherNest",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "../frontend/dist/**/*",
      "../rust/target/release/ciphernest-server"
    ],
    "extraResources": [
      {
        "from": "../rust/target/release/",
        "to": "rust/",
        "filter": ["ciphernest-server*"]
      }
    ],
    "win": {
      "target": ["nsis", "zip"],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "resources/icon.png"
    }
  },
  "dependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "eslint": "^9.0.0",
    "@types/node": "^22.0.0"
  }
}
